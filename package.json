{
  "name": "testgrid",
  "version": "1.2.0",
  "repository": "https://github.com/Wavix/testgrid",
  "author": "Wavix Inc.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "lint": "eslint ./src/ --quiet --color",
    "type": "tsc --project tsconfig.json --noEmit",
    "format": "prettier --write './src/**/*.{js,ts,json,tsx,scss}'",
    "start": "next start -p 7045",
    "cli": "node -r @swc-node/register ./src/app/database/cli.ts",
    "migrate": "node -r @swc-node/register ./src/app/database/migrate.ts",
    "migrate:create": "pnpm migrate create --folder ./src/app/migrations --name",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.6.2",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "eslint": "10.15.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "http-status": "^2.1.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "react-select": "^5.10.2",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "use-sound": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@svgr/webpack": "^8.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "autoprefixer": "^10.7.0",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "umzug": "^3.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  },
  "simple-pre-commit": "npx lint-staged",
  "lint-staged": {
    "*.{ts,js}": [
      "./node_modules/.bin/prettier -w './src/**/*.{ts,tsx}' ",
      "./node_modules/.bin/eslint ./src/ --quiet --color --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
