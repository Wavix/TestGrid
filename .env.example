NEXT_PUBLIC_JIRA_URL=https://your-company.atlassian.net
# SQLite file; defaults to database.sqlite in the working directory
# DATABASE_PATH=/data/database.sqlite
# Optional mapping for task names extracted from branch names, e.g. WX-123 -> DEV-123
JIRA_TASK_REPLACE_FROM=WX-
JIRA_TASK_REPLACE_TO=DEV-

# Optional Kubernetes stands. Leave K8S_ENABLED unset to keep stands manual.
# K8S_ENABLED=true
# Label key on cluster namespaces; its value is the stand name
# K8S_STAND_LABEL=example.org/stand
# TestGrid namespace that owns the cluster's stands
# K8S_TESTGRID_NAMESPACE=myorg
# Optional: label whose value "ephemeral" marks a personal stand (anything else is a shared stand)
# K8S_STAND_KIND_LABEL=example.org/stand-kind
# Optional: annotation with the owner's email, shown on the stand card
# K8S_STAND_OWNER_ANNOTATION=example.org/stand-owner
# Defaults to the in-cluster API and the pod's service account
# K8S_API_URL=https://kubernetes.default.svc
# K8S_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# K8S_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
